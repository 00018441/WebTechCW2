<h1 id="posts-page-title">Posts</h1>

<form
    id="search-form-posts"
    hx-get="{{postsListUrl}}"
    hx-target="#content"
    hx-swap="innerHTML"
>
    <div>
        <input
            type="text"
            name="title"
            placeholder="Search by post title…"
            autocomplete="off"
        />
        <input
            type="text"
            name="description"
            placeholder="Search by post description…"
            autocomplete="off"
        />
    </div>

    <button type="submit">Find</button>
</form>

<div id="posts-list-container">{{postCards}}</div>
<div id="load-more-button-container"></div>
