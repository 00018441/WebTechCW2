<div class="post-card">
    <button
        class="view-post-button"
        hx-get="{{viewPostUrl}}"
        hx-target="#content"
        hx-swap="innerHTML"
    >
        View
    </button>

    <div class="post-info-row">
        <div class="post-info-label">Title:</div>
        <div class="post-info-value">{{title}}</div>
    </div>
    <div class="post-info-row">
        <div class="post-info-label">Author:</div>
        {{usernameWithTooltip}}
    </div>
    <div class="post-info-row">
        <div class="post-info-label">Description:</div>
        <div class="post-info-value">{{description}}</div>
    </div>
    <div class="post-info-row">
        <div class="post-info-label">Created:</div>
        <div class="post-info-value">{{createdAgo}}</div>
    </div>
    <div class="post-info-row">
        <div class="post-info-label">Settings Count:</div>
        <div class="post-info-value posts-count">{{postSettingsCount}}</div>
    </div>
</div>
